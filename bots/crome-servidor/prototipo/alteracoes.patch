+// Minimal engine adapter: one real offline Player, normal game operations.
+int LuaScriptInterface::luaGameStartCromeBot(lua_State* L)
+{
+    const std::string name = getString(L, 1);
+    auto fail = [L](const char* reason) { lua_pushnil(L); lua_pushstring(L, reason); return 2; };
+    if (g_game.getGameState() != GAME_STATE_NORMAL) return fail("Server is not in normal state");
+    if (name.empty() || g_game.getPlayerByName(name)) return fail("Character missing or already online");
+    size_t internalCount = 0;
+    for (const auto& entry : g_game.getPlayers()) {
+        if (entry.second->isCromeInternalBot()) ++internalCount;
+    }
+    if (internalCount >= 20) return fail("Internal race limit: twenty players");
+    Player* bot = new Player(nullptr);
+    bot->incrementReferenceCounter(); // Own reference survives login callbacks/removal.
+    if (!IOLoginData::loadPlayerByName(bot, name)) {
+        bot->decrementReferenceCounter(); return fail("Could not load existing character");
+    }
+    BanInfo ban;
+    if (bot->getAccountType() != ACCOUNT_TYPE_NORMAL || bot->isAccessPlayer() ||
+        IOBan::isPlayerNamelocked(bot->getGUID()) || IOBan::isAccountBanned(bot->getAccount(), ban) ||
+        bot->getLevel() >= 8 || bot->getHealth() <= 0 || bot->getLastLoginSaved() <= 0 ||
+        (!bot->getInventoryItem(CONST_SLOT_BACKPACK) && !getBoolean(L, 3, false))) {
+        bot->decrementReferenceCounter(); return fail("Use an offline normal level1-7 character already initialized with backpack");
+    }
+    if (g_config.getBoolean(ConfigManager::ONE_PLAYER_ON_ACCOUNT) && g_game.getPlayerByAccount(bot->getAccount())) {
+        bot->decrementReferenceCounter(); return fail("Another character on this account is online");
+    }
+    Item* left = bot->getInventoryItem(CONST_SLOT_LEFT);
+    Item* right = bot->getInventoryItem(CONST_SLOT_RIGHT);
+    if ((!left || left->getAttack() <= 0) && (!right || right->getAttack() <= 0) && !getBoolean(L, 3, false)) {
+        bot->decrementReferenceCounter(); return fail("Equip a melee weapon before starting prototype");
+    }
+    const Position requested = getBoolean(L, 3, false) ? bot->getLoginPosition() : getPosition(L, 2);
+    Position spawn;
+    bool found = false;
+    // Never force-place, stack creatures, or spawn in a field/transition.
+    for (int32_t dx = -1; dx <= 1 && !found; ++dx) {
+        for (int32_t dy = -1; dy <= 1; ++dy) {
+            const int32_t x = int32_t(requested.x) + dx, y = int32_t(requested.y) + dy;
+            if (x < 1 || x > 65534 || y < 1 || y > 65534) continue;
+            const Position candidate(uint16_t(x), uint16_t(y), requested.z);
+            Tile* tile = g_game.map.getTile(candidate);
+            if (tile && tile->getGround() && !tile->getTopCreature() && !tile->getFieldItem() &&
+                !tile->getTeleportItem() && !tile->hasFlag(TILESTATE_FLOORCHANGE) &&
+                tile->queryAdd(0, *bot, 1, 0) == RETURNVALUE_NOERROR) {
+                spawn = candidate; found = true; break;
+            }
+        }
+    }
+    if (!found) { bot->decrementReferenceCounter(); return fail("No free safe spawn next to operator"); }
+    bot->cromeInternalBot = true;
+    bot->cromeLeaseUntil = OTSYS_TIME() + 15000;
+    bot->setFightMode(FIGHTMODE_ATTACK);
+    bot->setChaseMode(false); // Lua chooses safe individual engine steps.
+    if (!g_game.placeCreature(bot, spawn) || bot->isRemoved()) {
+        bot->decrementReferenceCounter(); return fail("Placement/login event rejected character");
+    }
+    bot->lastLoginSaved = std::max<time_t>(time(nullptr), bot->lastLoginSaved + 1);
+    const uint32_t id = bot->getID();
+    bot->decrementReferenceCounter(); // World now owns the live Player.
+    lua_pushnumber(L, id);
+    return 1;
+}
+
+int LuaScriptInterface::luaGameStopCromeBot(lua_State* L)
+{
+    Player* bot = g_game.getPlayerByID(getNumber<uint32_t>(L, 1));
+    if (!bot || !bot->isCromeInternalBot()) { pushBoolean(L, false); return 1; }
+    bot->setAttackedCreature(nullptr); bot->setFollowCreature(nullptr);
+    bot->kickPlayer(true); // Normal logout path updates online status and saves.
+    pushBoolean(L, true); return 1;
+}
+
+int LuaScriptInterface::luaPlayerIsCromeInternalBot(lua_State* L)
+{
+    Player* bot = getUserdata<Player>(L, 1);
+    pushBoolean(L, bot && bot->isCromeInternalBot()); return 1;
+}
+
+int LuaScriptInterface::luaPlayerCromeHeartbeat(lua_State* L)
+{
+    Player* bot = getUserdata<Player>(L, 1);
+    if (!bot || !bot->isCromeInternalBot()) { pushBoolean(L, false); return 1; }
+    bot->cromeLeaseUntil = OTSYS_TIME() + 5000;
+    bot->resetIdleTime(); pushBoolean(L, true); return 1;
+}
