+// Normal adjacent object interaction for quest/door validation. No storage writes.
+int LuaScriptInterface::luaPlayerCromeUseObject(lua_State* L)
+{
+    Player* bot = getUserdata<Player>(L, 1);
+    Item* item = getUserdata<Item>(L, 2);
+    Item* target = lua_gettop(L) >= 3 ? getUserdata<Item>(L, 3) : nullptr;
+    auto fail = [L](const char* reason) { pushBoolean(L, false); lua_pushstring(L, reason); return 2; };
+    if (!bot || !bot->isCromeInternalBot() || !item || item->isRemoved()) return fail("INVALID_CONTEXT");
+    if (!bot->canDoAction() || bot->getWalkDelay() > 0) return fail("COOLDOWN");
+    const Position pos = target ? target->getPosition() : item->getPosition();
+    if (!bot->canSee(pos) || !Position::areInRange<1, 1, 0>(pos, bot->getPosition())) return fail("OUT_OF_RANGE");
+    Tile* tile = g_game.map.getTile(pos);
+    if (!tile || tile->getFieldItem()) return fail("UNSAFE_TILE");
+    if (target) {
+        Cylinder* owner = item->getParent();
+        while (owner && owner != bot) owner = owner->getParent();
+        if (owner != bot || item->getID() < 2087 || item->getID() > 2092 || target->isRemoved() || target->getParent() != tile) return fail("INVALID_KEY_TARGET");
+        pushBoolean(L, g_actions->useItemEx(bot, item->getPosition(), pos, 0, item, false));
+    } else {
+        if (item->getParent() != tile) return fail("NOT_WORLD_OBJECT");
+        const auto& type = Item::items[item->getID()];
+        const bool recognized = item->getActionId() == 65535 || type.isDoor() || item->getID() == 1945 || item->getID() == 1946 || item->getID() == 430 || item->getID() == 1386 || item->getID() == 3678 || item->getID() == 2785;
+        if (!recognized) return fail("UNSUPPORTED_OBJECT");
+        pushBoolean(L, g_actions->useItem(bot, pos, 0, item, false));
+    }
+    lua_pushstring(L, "SENT_VERIFY_OBSERVATION"); return 2;
+}
