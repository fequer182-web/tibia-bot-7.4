+// Use a visible adjacent access through the registered server action.
+int LuaScriptInterface::luaPlayerCromeUseAccess(lua_State* L)
+{
+    Player* bot = getUserdata<Player>(L, 1);
+    Item* item = getUserdata<Item>(L, 2);
+    auto fail = [L](const char* reason) { pushBoolean(L, false); lua_pushstring(L, reason); return 2; };
+    if (!bot || !bot->isCromeInternalBot() || !item || item->isRemoved()) return fail("INVALID_CONTEXT");
+    if (!bot->canDoAction() || bot->getWalkDelay() > 0) return fail("COOLDOWN");
+    const Position pos = item->getPosition();
+    if (!bot->canSee(pos) || !Position::areInRange<1, 1, 0>(pos, bot->getPosition())) return fail("OUT_OF_RANGE");
+    Tile* tile = item->getTile();
+    if (!tile || item->getParent() != tile || tile->getFieldItem()) return fail("UNSAFE_TILE");
+    const uint16_t id = item->getID();
+    if (id != 430 && id != 1386 && id != 3678 && !((id == 1945 || id == 1946) && item->getActionId() == 3100)) return fail("UNSUPPORTED_ACCESS");
+    pushBoolean(L, g_actions->useItem(bot, pos, 0, item, false));
+    lua_pushstring(L, "SENT_VERIFY_POSITION"); return 2;
+}
