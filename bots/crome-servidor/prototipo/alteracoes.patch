+int LuaScriptInterface::luaPlayerCromeTakeLoot(lua_State* L)
+{
+    Player* bot = getUserdata<Player>(L, 1);
+    Item** raw = getRawUserdata<Item>(L, 2);
+    Item* item = raw ? *raw : nullptr;
+    Container* destination = getUserdata<Container>(L, 3);
+    if (!bot || !bot->isCromeInternalBot() || !item || item->isRemoved() || (destination && destination->isRemoved())) {
+        pushBoolean(L, false); lua_pushstring(L, "INVALID_CONTEXT"); return 2;
+    }
+    if (!bot->canDoAction()) {
+        pushBoolean(L, false); lua_pushstring(L, "COOLDOWN"); return 2;
+    }
+    Container* corpse = item->getParent() ? item->getParent()->getContainer() : nullptr;
+    Cylinder* receiver = destination ? static_cast<Cylinder*>(destination) : static_cast<Cylinder*>(bot); Cylinder* owner = receiver;
+    while (owner && owner != bot) owner = owner->getParent();
+    const uint16_t id = item->getID();
+    if (!corpse || corpse->getCorpseOwner() != bot->getID() || owner != bot ||
+        !item->isPickupable() || corpse->getPosition().z != bot->getPosition().z ||
+        Position::getDistanceX(corpse->getPosition(), bot->getPosition()) > 1 ||
+        Position::getDistanceY(corpse->getPosition(), bot->getPosition()) > 1) {
+        pushBoolean(L, false); return 1;
+    }
+    const Position from = item->getPosition(), to = (destination ? destination->getPosition() : Position(0xFFFF, 0, 0));
+    Item* moved = nullptr;
+    const ReturnValue result = g_game.internalMoveItem(corpse, receiver, INDEX_WHEREEVER, item, item->getItemCount(), &moved, 0, bot, nullptr, &from, &to);
+    if (moved) *raw = moved; // Preserve userdata if a stack was merged/replaced.
+    pushBoolean(L, result == RETURNVALUE_NOERROR); lua_pushnumber(L, result); return 2;
+}
