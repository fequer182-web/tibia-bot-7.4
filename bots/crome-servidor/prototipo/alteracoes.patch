+int LuaScriptInterface::luaPlayerCromeCanStep(lua_State* L)
+{
+    Player* bot = getUserdata<Player>(L, 1);
+    const Position pos = getPosition(L, 2);
+    Tile* tile = g_game.map.getTile(pos);
+    const bool allowed = bot && bot->isCromeInternalBot() && pos.z == bot->getPosition().z && bot->canSee(pos) &&
+        tile && tile->getGround() && !tile->getTopCreature() && !tile->getFieldItem() && !tile->getTeleportItem() &&
+        (!tile->hasFlag(TILESTATE_FLOORCHANGE) || getBoolean(L, 3, false)) && tile->queryAdd(0, *bot, 1, 0) == RETURNVALUE_NOERROR;
+    pushBoolean(L, allowed); return 1;
+}
+
+int LuaScriptInterface::luaPlayerCromeStep(lua_State* L)
+{
+    Player* bot = getUserdata<Player>(L, 1);
+    const uint32_t dir = getNumber<uint32_t>(L, 2);
+    if (!bot || !bot->isCromeInternalBot() || dir > 7 || bot->getWalkDelay() > 0 || bot->isMovementBlocked()) {
+        pushBoolean(L, false); return 1;
+    }
+    const Position dest = getNextPosition(static_cast<Direction>(dir), bot->getPosition());
+    Tile* tile = g_game.map.getTile(dest);
+    if (!tile || !tile->getGround() || tile->getTopCreature() || tile->getFieldItem() || tile->getTeleportItem() ||
+        (tile->hasFlag(TILESTATE_FLOORCHANGE) && !getBoolean(L, 3, false)) || tile->queryAdd(0, *bot, 1, 0) != RETURNVALUE_NOERROR) {
+        pushBoolean(L, false); return 1;
+    }
+    bot->startAutoWalk(static_cast<Direction>(dir)); // Normal movement scheduling, no FLAG_NOLIMIT.
+    pushBoolean(L, true); return 1; // Accepted; Lua still verifies actual position.
+}
