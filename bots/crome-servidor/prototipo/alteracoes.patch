+int LuaScriptInterface::luaPlayerCromeUseFood(lua_State* L)
+{
+    Player* bot = getUserdata<Player>(L, 1);
+    Item* item = getUserdata<Item>(L, 2);
+    if (!bot || !bot->isCromeInternalBot() || !item || item->isRemoved() || !bot->canDoAction()) {
+        pushBoolean(L, false); return 1;
+    }
+    Cylinder* owner = item->getParent();
+    while (owner && owner != bot) owner = owner->getParent();
+    const uint16_t id = item->getID();
+    if (owner != bot || (id != 2362 && id != 2666 && id != 2667 && id != 2668 && id != 2669 && id != 2670 && id != 2671 && id != 2672 && id != 2673 && id != 2674 && id != 2675 && id != 2676 && id != 2677 && id != 2678 && id != 2679 && id != 2680 && id != 2681 && id != 2682 && id != 2683 && id != 2684 && id != 2685 && id != 2686 && id != 2687 && id != 2688 && id != 2689 && id != 2690 && id != 2691 && id != 2695 && id != 2696 && id != 2787 && id != 2788 && id != 2789 && id != 2790 && id != 2791 && id != 2792 && id != 2793 && id != 2794 && id != 2795 && id != 2796)) {
+        pushBoolean(L, false); return 1;
+    }
+    // Calls this OT's registered food action (satiety, feeding duration, consumption).
+    pushBoolean(L, g_actions->useItem(bot, item->getPosition(), 0, item, false)); return 1;
+}
